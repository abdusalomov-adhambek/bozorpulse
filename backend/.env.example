BP_ADDR=:8080
APP_ENV=development
DATABASE_URL=postgres://bozorpulse:bozorpulse@localhost:55433/bozorpulse?sslmode=disable
JWT_SECRET=dev-only-secret

# AI / LLM (Meta Model API — https://api.meta.ai, keys: https://dev.meta.ai)
# LLM is on by default. If MODEL_API_KEY is empty the app falls back to the
# rule-based assistant and makes no network calls.
AI_LLM_ENABLED=true
MODEL_API_KEY=
# Optional aliases (MODEL_API_KEY takes precedence):
# LLM_API_KEY=
# META_API_KEY=
LLM_API_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
LLM_MAX_TOKENS=1600
LLM_TIMEOUT=15s
AI_MAX_TOOL_ROUNDS=5
